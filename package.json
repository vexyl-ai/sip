{
  "name": "@vexyl.ai/sip",
  "description": "Pure Node.js SIP stack for AI voice agents — no native deps, no sidecar",
  "version": "1.0.4",
  "homepage": "https://github.com/vexyl-ai/sip",
  "author": "Vexyl AI",
  "contributors": [
    "Kirill Mikhailov <kirill.mikhailov@gmail.com>",
    "Anil Mathew <anilmathewm@yahoo.co.uk>"
  ],
  "main": "sip",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./sip.js"
    },
    "./sdp": {
      "types": "./sdp.d.ts",
      "default": "./sdp.js"
    },
    "./rtp": {
      "types": "./rtp.d.ts",
      "default": "./rtp.js"
    },
    "./dtmf": {
      "types": "./dtmf.d.ts",
      "default": "./dtmf.js"
    },
    "./digest": {
      "types": "./digest.d.ts",
      "default": "./digest.js"
    },
    "./dialog": {
      "types": "./dialog.d.ts",
      "default": "./dialog.js"
    },
    "./stack": {
      "types": "./stack.d.ts",
      "default": "./stack.js"
    },
    "./vexyl-sip-bridge": {
      "types": "./vexyl-sip-bridge.d.ts",
      "default": "./vexyl-sip-bridge.js"
    }
  },
  "scripts": {
    "test": "./node_modules/.bin/coffee test/runtests.coffee",
    "test:phase3": "node test/test-phase3.js",
    "test:phase4": "node test/test-phase4.js",
    "test:phase5": "node test/test-phase5.js",
    "test:all": "node test/test-phase3.js && node test/test-phase4.js && node test/test-phase5.js",
    "test:register": "node test/test-register.js",
    "start:sip": "node sip-server.js"
  },
  "directories": {
    "lib": "",
    "example": "./examples",
    "doc": "./doc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vexyl-ai/sip.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "ws": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "coffee-script": "~1.6.2",
    "ws": "^7.5.10"
  }
}
